#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SHARED_ENV_FILE="${ROOT}/.claude/harness.control-plane.shared.env"
GUI_DOMAIN="gui/$(id -u)"

if [[ ! -f "$SHARED_ENV_FILE" ]]; then
  echo "Missing ${SHARED_ENV_FILE}. Run ./bin/setup_shared_harness_control_plane first." >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$SHARED_ENV_FILE"

TENANT_ID="${CLAUDE_CODE_HARNESS_TENANT_ID:-shared}"
SAFE_TENANT="$(printf '%s' "$TENANT_ID" | tr -cs 'A-Za-z0-9._-' '-')"
RUNNER_IDS=()
while IFS= read -r runner_id; do
  [[ -n "$runner_id" ]] || continue
  RUNNER_IDS+=("$runner_id")
done < <(bun ./scripts/harnessRunnerManifest.ts list --ids)

for runner_id in "${RUNNER_IDS[@]}"; do
  SAFE_RUNNER="$(printf '%s' "$runner_id" | tr -cs 'A-Za-z0-9._-' '-')"
  LABEL="com.gaganarora.cc.harness.${SAFE_TENANT}.${SAFE_RUNNER}"
  echo "== ${LABEL} =="
  if launchctl print "${GUI_DOMAIN}/${LABEL}" >/tmp/cc-harness-launchd-status.$$ 2>&1; then
    rg "state =|pid =" /tmp/cc-harness-launchd-status.$$ || cat /tmp/cc-harness-launchd-status.$$
  else
    cat /tmp/cc-harness-launchd-status.$$
  fi
  echo
done

rm -f /tmp/cc-harness-launchd-status.$$

if [[ -f "${ROOT}/.claude/harness.control-plane.shared.env" ]]; then
  # shellcheck disable=SC1090
  source "${ROOT}/.claude/harness.control-plane.shared.env"
fi
exec bun ./entrypoints/cli.tsx daemon status --json
