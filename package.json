{
  "name": "claude-code-rebuilt",
  "description": "Agentic coding CLI with team workflows, MCP integrations, Conductor readiness checks, and autoresearch guardrails.",
  "version": "0.0.0-rebuilt",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "homepage": "https://github.com/gagan114662/cc",
  "repository": {
    "type": "git",
    "url": "https://github.com/gagan114662/cc.git"
  },
  "bugs": {
    "url": "https://github.com/gagan114662/cc/issues"
  },
  "keywords": [
    "agent",
    "ai",
    "bun",
    "cli",
    "conductor",
    "developer-tools",
    "mcp"
  ],
  "engines": {
    "bun": ">=1.2.23"
  },
  "bin": {
    "claude": "./entrypoints/cli.tsx"
  },
  "scripts": {
    "dev": "bun ./entrypoints/cli.tsx",
    "repo:bootstrap": "bun ./scripts/repoBootstrap.ts",
    "repo:facts": "bun ./scripts/repoFacts.ts",
    "report:check": "bun ./scripts/reportCheck.ts",
    "report:open": "bun ./scripts/reportOpen.ts",
    "conductor:doctor": "bun ./scripts/conductorDoctor.ts --repo .",
    "conductor:proof": "bun ./scripts/conductorDoctor.ts --repo . --html ./conductor-readiness-proof.html",
    "autoresearch:status": "bun ./scripts/autoresearchStatus.ts",
    "build:autoresearch-cycle": "bun build ./scripts/autoresearchCycle.ts --outfile ./dist/autoresearch-cycle.js --target bun --format esm --define MACRO='{\"VERSION\":\"0.0.0-rebuilt\",\"BUILD_TIME\":\"2026-03-31T00:00:00.000Z\",\"FEEDBACK_CHANNEL\":\"#claude-code\",\"ISSUES_EXPLAINER\":\"open an issue\",\"PACKAGE_URL\":\"@anthropic-ai/claude-code\",\"NATIVE_PACKAGE_URL\":\"@anthropic-ai/claude-code-native\",\"VERSION_CHANGELOG\":\"\"}'",
    "autoresearch:cycle": "bun run build:autoresearch-cycle && bun ./dist/autoresearch-cycle.js",
    "typecheck": "tsc --noEmit --allowJs false --skipLibCheck ./types/employee.ts",
    "lint": "eslint ./types/employee.ts ./utils/employeeConfig.ts ./tools/AgentTool/builtInAgents.ts ./tools/AgentTool/built-in/engineeringLeadAgent.ts ./commands/employee/index.ts ./commands/employee/employee.tsx ./scripts/employeeSmoke.ts ./entrypoints/cli.tsx --cache --no-error-on-unmatched-pattern",
    "build": "bun build ./entrypoints/cli.tsx --outfile ./dist/cli.js --target bun --format esm --define MACRO='{\"VERSION\":\"0.0.0-rebuilt\",\"BUILD_TIME\":\"2026-03-31T00:00:00.000Z\",\"FEEDBACK_CHANNEL\":\"#claude-code\",\"ISSUES_EXPLAINER\":\"open an issue\",\"PACKAGE_URL\":\"@anthropic-ai/claude-code\",\"NATIVE_PACKAGE_URL\":\"@anthropic-ai/claude-code-native\",\"VERSION_CHANGELOG\":\"\"}' --external @ant/computer-use-mcp --external @ant/computer-use-mcp/types --external @ant/computer-use-mcp/sentinelApps --external @ant/claude-for-chrome-mcp --external @ant/computer-use-swift --external @ant/computer-use-input --external @anthropic-ai/mcpb --external @anthropic-ai/sandbox-runtime --external audio-capture-napi --external color-diff-napi --external image-processor-napi --external url-handler-napi",
    "build:employee-smoke": "bun build ./scripts/employeeSmoke.ts --outfile ./dist/employee-smoke.js --target bun --format esm --define MACRO='{\"VERSION\":\"0.0.0-rebuilt\",\"BUILD_TIME\":\"2026-03-31T00:00:00.000Z\",\"FEEDBACK_CHANNEL\":\"#claude-code\",\"ISSUES_EXPLAINER\":\"open an issue\",\"PACKAGE_URL\":\"@anthropic-ai/claude-code\",\"NATIVE_PACKAGE_URL\":\"@anthropic-ai/claude-code-native\",\"VERSION_CHANGELOG\":\"\"}' --external ./protectedNamespace.js --external @aws-sdk/client-sts",
    "build:honeycomb-smoke": "bun build ./scripts/honeycombSmoke.ts --outfile ./dist/honeycomb-smoke.js --target bun --format esm --define MACRO='{\"VERSION\":\"0.0.0-rebuilt\",\"BUILD_TIME\":\"2026-03-31T00:00:00.000Z\",\"FEEDBACK_CHANNEL\":\"#claude-code\",\"ISSUES_EXPLAINER\":\"open an issue\",\"PACKAGE_URL\":\"@anthropic-ai/claude-code\",\"NATIVE_PACKAGE_URL\":\"@anthropic-ai/claude-code-native\",\"VERSION_CHANGELOG\":\"\"}'",
    "build:honeycomb-verify": "bun build ./scripts/honeycombVerify.ts --outfile ./dist/honeycomb-verify.js --target bun --format esm --define MACRO='{\"VERSION\":\"0.0.0-rebuilt\",\"BUILD_TIME\":\"2026-03-31T00:00:00.000Z\",\"FEEDBACK_CHANNEL\":\"#claude-code\",\"ISSUES_EXPLAINER\":\"open an issue\",\"PACKAGE_URL\":\"@anthropic-ai/claude-code\",\"NATIVE_PACKAGE_URL\":\"@anthropic-ai/claude-code-native\",\"VERSION_CHANGELOG\":\"\"}'",
    "smoke:cli": "bun ./entrypoints/cli.tsx --version",
    "smoke:help": "bun ./entrypoints/cli.tsx --help",
    "smoke:harness": "bun ./entrypoints/cli.tsx harness status --json",
    "smoke:daemon": "bun ./entrypoints/cli.tsx daemon status --json",
    "harness:control-plane:setup": "./bin/setup_harness_control_plane",
    "harness:control-plane:status": "bash -lc 'if [ -f ./.claude/harness.control-plane.env ]; then source ./.claude/harness.control-plane.env; fi; bun ./entrypoints/cli.tsx harness status --json'",
    "harness:control-plane:doctor": "bash -lc 'if [ -f ./.claude/harness.control-plane.shared.env ]; then source ./.claude/harness.control-plane.shared.env; elif [ -f ./.claude/harness.control-plane.env ]; then source ./.claude/harness.control-plane.env; fi; bun ./scripts/harnessControlPlaneDoctor.ts --json'",
    "harness:control-plane:down": "./bin/stop_harness_control_plane",
    "harness:shared:setup": "./bin/setup_shared_harness_control_plane",
    "harness:shared:daemon:start": "./bin/start_shared_harness_daemon",
    "harness:shared:daemon:status": "bash -lc 'if [ -f ./.claude/harness.control-plane.shared.env ]; then source ./.claude/harness.control-plane.shared.env; fi; bun ./entrypoints/cli.tsx daemon status --json'",
    "harness:shared:daemon:stop": "bash -lc 'if [ -f ./.claude/harness.control-plane.shared.env ]; then source ./.claude/harness.control-plane.shared.env; fi; bun ./entrypoints/cli.tsx daemon stop'",
    "harness:service:install": "./bin/install_shared_harness_launch_agents",
    "harness:service:status": "./bin/status_shared_harness_launch_agents",
    "harness:service:uninstall": "./bin/uninstall_shared_harness_launch_agents",
    "harness:service:restart": "bash -lc './bin/uninstall_shared_harness_launch_agents && ./bin/install_shared_harness_launch_agents'",
    "harness:observability:setup": "./bin/setup_harness_observability",
    "harness:observability:setup:chrome": "./bin/setup_harness_observability_from_chrome",
    "harness:observability:doctor": "bash -lc 'if [ -f ./.claude/harness.control-plane.shared.env ]; then source ./.claude/harness.control-plane.shared.env; fi; if [ -f ./.claude/harness.observability.env ]; then source ./.claude/harness.observability.env; fi; bun ./scripts/harnessObservabilityDoctor.ts --json'",
    "harness:observability:smoke": "bash -lc 'if [ -f ./.claude/harness.observability.env ]; then source ./.claude/harness.observability.env; fi; bun ./scripts/honeycombSmoke.ts'",
    "smoke:bundle": "bun --preload ./test/preload.ts ./dist/cli.js --version",
    "smoke:bundle-help": "bun ./dist/cli.js --help",
    "smoke:bundle-harness": "bun ./dist/cli.js harness status --json",
    "smoke:bundle-daemon": "bun ./dist/cli.js daemon status --json",
    "smoke:employee": "bun ./scripts/employeeSmoke.ts",
    "smoke:honeycomb": "bun run build:honeycomb-smoke && bun ./dist/honeycomb-smoke.js",
    "honeycomb:deploy-slos": "bun ./scripts/honeycombDeploySLOs.ts --json",
    "honeycomb:verify": "bun ./scripts/honeycombVerify.ts --json",
    "honeycomb:proof": "bun ./scripts/honeycombVerify.ts --html ./honeycomb-autoresearch-proof.html",
    "test": "bun test ./test",
    "test:repo": "bun run test && bun run test:test-quality",
    "test:test-quality": "bun ./scripts/testQualityCheck.ts --root .",
    "test:quality:proof": "bun ./scripts/testQualityCheck.ts --root . --html ./test-quality-proof.html",
    "test:deterministic-harness": "bun test ./test/deterministicHarnessRuntime.test.ts",
    "test:autoresearch": "bun test ./test/autoresearchRuntime.test.ts ./test/autoresearchClaudeCodeSessions.test.ts",
    "pipeline": "bun run typecheck && bun run lint && bun run test:repo && bun run build && bun run build:employee-smoke && bun run smoke:cli && bun run smoke:help && bun run smoke:harness && bun run smoke:daemon && bun run smoke:bundle && bun run smoke:bundle-help && bun run smoke:bundle-harness && bun run smoke:bundle-daemon && bun run smoke:employee",
    "start:daemon": "bun ./entrypoints/daemon.ts",
    "daemon:once": "bun ./entrypoints/daemon.ts --once",
    "build:daemon": "bun build ./entrypoints/daemon.ts --outfile ./dist/daemon.js --target bun --format esm",
    "docker:build": "docker build -t cc-rebuilt:local .",
    "docker:run": "docker run --rm -p 8181:8181 -v \"$PWD/.claude:/app/.claude:ro\" cc-rebuilt:local"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.1.3",
    "@anthropic-ai/bedrock-sdk": "^0.26.4",
    "@anthropic-ai/claude-agent-sdk": "^0.1.15",
    "@anthropic-ai/foundry-sdk": "^0.2.3",
    "@anthropic-ai/sdk": "^0.63.0",
    "@anthropic-ai/vertex-sdk": "^0.14.4",
    "@aws-sdk/client-bedrock": "^3.917.0",
    "@aws-sdk/client-bedrock-runtime": "^3.917.0",
    "@aws-sdk/client-sts": "^3.1021.0",
    "@aws-sdk/credential-provider-node": "^3.917.0",
    "@aws-sdk/credential-providers": "^3.917.0",
    "@azure/identity": "^4.13.0",
    "@commander-js/extra-typings": "^14.0.0",
    "commander": "^14.0.0",
    "@growthbook/growthbook": "^1.4.1",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.205.0",
    "@opentelemetry/core": "^2.1.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.214.0",
    "@opentelemetry/exporter-prometheus": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.214.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-logs": "^0.205.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@smithy/core": "^3.17.3",
    "@smithy/node-http-handler": "^4.4.5",
    "ajv": "^8.17.1",
    "asciichart": "^1.5.25",
